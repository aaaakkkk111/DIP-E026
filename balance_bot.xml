<mujoco model="two_wheel_balance_bot">
  <!-- World axes: X forward, Y left, Z up. -->
  <compiler angle="radian" inertiafromgeom="true" autolimits="true" />
  <option timestep="0.002" gravity="0 0 -9.81" integrator="implicitfast"
          solver="Newton" iterations="50" tolerance="1e-10" />

  <default>
    <joint damping="0.003" armature="0.004" />
    <geom condim="4" friction="1.5 0.02 0.001" density="600"
          rgba="0.25 0.35 0.55 1" />
    <motor ctrllimited="true" ctrlrange="-4 4" />
  </default>

  <worldbody>
    <light name="key" pos="0 -3 5" dir="0 0 -1" directional="true" />
    <light name="fill" pos="-3 2 2" dir="1 -1 -0.5" />
    <geom name="ground" type="plane" size="8 8 0.1" rgba="0.16 0.18 0.22 1"
          friction="1.5 0.02 0.001" />

    <!-- The free-joint frame is deliberately at the wheel axle.  Keeping the
         body mass above it creates the inverted-pendulum dynamics. -->
    <body name="chassis" pos="0 0 0.160">
      <freejoint name="root" />
      <geom name="body" type="box" pos="0 0 0.18" size="0.16 0.11 0.17"
            mass="2.2" rgba="0.12 0.32 0.78 1" />
      <geom name="battery" type="box" pos="-0.055 0 0.085" size="0.075 0.075 0.055"
            mass="0.55" rgba="0.08 0.09 0.11 1" />
      <geom name="mast" type="capsule" pos="0.06 0 0.41" size="0.035 0.12"
            mass="0.35" rgba="0.95 0.58 0.10 1" />
      <site name="imu" pos="0 0 0" size="0.005" rgba="1 0 0 1" />

      <body name="left_wheel" pos="0 0.155 0">
        <joint name="left_wheel_hinge" type="hinge" axis="0 1 0" />
        <geom name="left_tire" type="cylinder" size="0.16 0.030" euler="1.570796 0 0"
              mass="0.28" rgba="0.055 0.055 0.065 1" />
        <geom name="left_hub" type="cylinder" size="0.055 0.032" euler="1.570796 0 0"
              mass="0.07" rgba="0.82 0.84 0.88 1" />
      </body>

      <body name="right_wheel" pos="0 -0.155 0">
        <joint name="right_wheel_hinge" type="hinge" axis="0 1 0" />
        <geom name="right_tire" type="cylinder" size="0.16 0.030" euler="1.570796 0 0"
              mass="0.28" rgba="0.055 0.055 0.065 1" />
        <geom name="right_hub" type="cylinder" size="0.055 0.032" euler="1.570796 0 0"
              mass="0.07" rgba="0.82 0.84 0.88 1" />
      </body>
    </body>
  </worldbody>

  <actuator>
    <motor name="left_motor" joint="left_wheel_hinge" gear="1" />
    <motor name="right_motor" joint="right_wheel_hinge" gear="1" />
  </actuator>

  <sensor>
    <!-- Measurements are expressed in the chassis frame. -->
    <gyro name="chassis_gyro" site="imu" />
    <velocimeter name="chassis_velocity" site="imu" />
  </sensor>
</mujoco>
