{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: current file",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    },
    {
      "name": "Drive the trained policy (enjoy_drive.py)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/enjoy_drive.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    },
    {
      "name": "Drive without the slider panel (enjoy_drive.py --no-gui)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/enjoy_drive.py",
      "args": ["--no-gui"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    },
    {
      "name": "Train (train_real_robot.py, ~2.5 h)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/train_real_robot.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    },
    {
      "name": "Export float weights (export_stm32.py)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/export_stm32.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    },
    {
      "name": "Export int16 weights (quantize_weights.py)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/firmware/quantize_weights.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    },
    {
      "name": "Check a car-test log (check_car_log.py)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/firmware/check_car_log.py",
      "args": ["${input:carLog}", "--plot"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    }
  ],
  "inputs": [
    {
      "id": "carLog",
      "type": "promptString",
      "description": "Path to rl_serial_log.txt",
      "default": "../rl_mode28_20261003/rl_serial_log.txt"
    }
  ]
}
