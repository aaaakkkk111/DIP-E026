+/* called at the end of every control tick, all modes (stock app_control.c) */
+void TUNE_Sample(float gyro, float angle, int ml, int mr, int el, int er)
+{
+    unsigned short h = lg_head, n = (unsigned short)((h + 1) % LG_N);
+    short *s = lg[h];
+    ++lg_k;
+    if (!lg_on || n == lg_tail) return;
+    s[0] = (short)lg_k; s[1] = (short)(angle * 100.0f); s[2] = (short)gyro;
+    s[3] = (short)ml; s[4] = (short)mr; s[5] = (short)el; s[6] = (short)er;
+    s[7] = (short)raw_acc[1]; s[8] = (short)raw_acc[2];
+    lg_head = n;
+}
+
+void LOG_Poll(void)
+{
+    while (lg_tail != lg_head) {
+        short *s = lg[lg_tail];
+        printf("P %u %d %d %d %d %d %d %d %d\r\n", (unsigned short)s[0], s[1], s[2], s[3], s[4],
+               s[5], s[6], s[7], s[8]);
+        lg_tail = (unsigned short)((lg_tail + 1) % LG_N);
+    }
+}
+
