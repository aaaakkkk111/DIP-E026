+/* 200 Hz stream (car_firmware_pidlog): every control tick, in mode 1 and
+   mode 28, "P <k> <angle*100> <gyro> <L> <R> <encL> <encR> <accY> <accZ>":
+   the stock Angle_Balance (deg) and Gyro_Balance (raw, -gyro X), the PWM
+   that reached the motors (0 when cut), the encoder deltas, and the raw
+   accelerometer Y and Z the stock Kalman filter uses. The ISR fills a ring,
+   LOG_Poll prints it; a gap in k means the ring overflowed. */
+#define LG_N 128
+static short lg[LG_N][9];
+static volatile unsigned short lg_head, lg_tail, lg_k;
