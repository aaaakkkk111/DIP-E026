.env

# Files generated by training
models/
logs/
# models/best_real/best_model.zip (the current checkpoint, run 8) is tracked
# anyway, via `git add -f`, so the repo is runnable/flashable without
# retraining first - a `!` exception here does NOT work: git never descends
# into a directory a `dir/`-pattern already excludes, so it can't re-include
# anything beneath it (this is why the old models/best_their/ exception
# never actually did anything either; that file was tracked by being added
# before this rule existed, not because of its `!` lines).

# MuJoCo / editor auto-generated, not authored
MUJOCO_LOG.TXT
mjmodel.xml

