<mujoco model="yahboom_3d_realistic">
    <compiler angle="radian"/>
    <option timestep="0.005" gravity="0 0 -9.81"/>

    <worldbody>
        <light pos="0 0 3" dir="0 0 -1"/>
        <geom name="floor" type="plane" size="5 5 0.1" rgba="0.8 0.9 0.8 1"/>
        
        <!-- CHASSIS -->
        <body name="chassis" pos="0 0 0.033">
            <freejoint name="root_joint"/> 
            
            <geom name="base_bracket" type="box" pos="0 0 0" size="0.03 0.05 0.005" mass="0.1" rgba="0.2 0.2 0.2 1"/>
            <geom name="battery_box" type="box" pos="0 0 0.03" size="0.04 0.06 0.02" mass="0.6" rgba="0.1 0.1 0.1 1"/>
            <geom name="pcb" type="box" pos="0 0 0.065" size="0.04 0.05 0.002" mass="0.1" rgba="0.2 0.6 0.3 1"/>
            
            <geom name="eye_left" type="cylinder" pos="0.04 0.02 0.07" size="0.01 0.01" euler="0 1.5708 0" mass="0.01" rgba="0.2 0.5 0.8 1"/>
            <geom name="eye_right" type="cylinder" pos="0.04 -0.02 0.07" size="0.01 0.01" euler="0 1.5708 0" mass="0.01" rgba="0.2 0.5 0.8 1"/>

            <geom name="top_plate" type="box" pos="0 0 0.11" size="0.05 0.07 0.002" mass="0.05" rgba="0.7 0.7 0.7 0.8"/>
            
            <geom type="cylinder" pos="0.03 0.04 0.07" size="0.003 0.04" mass="0.01" rgba="0.8 0.7 0.3 1"/>
            <geom type="cylinder" pos="0.03 -0.04 0.07" size="0.003 0.04" mass="0.01" rgba="0.8 0.7 0.3 1"/>
            <geom type="cylinder" pos="-0.03 0.04 0.07" size="0.003 0.04" mass="0.01" rgba="0.8 0.7 0.3 1"/>
            <geom type="cylinder" pos="-0.03 -0.04 0.07" size="0.003 0.04" mass="0.01" rgba="0.8 0.7 0.3 1"/>

            <!-- DYNAMIC PAYLOAD -->
            <body name="payload_body" pos="0 0 0.13">
                <geom name="payload_geom" type="box" size="0.03 0.03 0.02" mass="0.0" rgba="0.9 0.2 0.2 1"/>
            </body>

            <!-- LEFT WHEEL -->
            <body name="left_wheel" pos="0 0.08 0">
                <joint name="left_motor_joint" type="hinge" axis="0 1 0" damping="0.01"/>
                <geom type="cylinder" size="0.033 0.015" mass="0.05" rgba="0.1 0.4 0.8 1" euler="1.5708 0 0"/>
            </body>

            <!-- RIGHT WHEEL -->
            <body name="right_wheel" pos="0 -0.08 0">
                <joint name="right_motor_joint" type="hinge" axis="0 1 0" damping="0.01"/>
                <geom type="cylinder" size="0.033 0.015" mass="0.05" rgba="0.1 0.4 0.8 1" euler="1.5708 0 0"/>
            </body>
        </body>
    </worldbody>

    <!-- UPGRADED MOTOR TORQUE -->
    <actuator>
        <motor name="left_motor" joint="left_motor_joint" gear="1" ctrlrange="-4.0 4.0" ctrllimited="true"/>
        <motor name="right_motor" joint="right_motor_joint" gear="1" ctrlrange="-4.0 4.0" ctrllimited="true"/>
    </actuator>
</mujoco>
